FROM rust:1-bookworm

RUN apt-get update && \
    apt-get install -y valgrind libc6-dbg build-essential tree && \
    rm -rf /var/lib/apt/lists/*

# RUN rustup toolchain install nightly
RUN rustup toolchain install stable

# Match this version to the gungraun dependency in your Cargo.lock.
RUN cargo install gungraun-runner --version 0.20.0

WORKDIR /workspace
